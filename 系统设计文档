### 3.5 前后端类型共享方案

`packages/shared-types` 包定义前后端共用的 TypeScript 类型：

```typescript
// packages/shared-types/src/index.ts

// 咖啡记录
export interface CoffeeRecord {
  id: string;
  userId: string;
  shopId?: string;
  shopName?: string;
  shopBrand?: string;
  coffeeCategory: CoffeeCategory;
  beanOrigin?: string;
  roastLevel?: RoastLevel;
  processMethod?: ProcessMethod;
  flavorTags: string[];
  rating: number;
  price?: number;
  review?: string;
  photoUrls: string[];
  cardImageUrl?: string;
  cardSource?: CardSource;
  cardStatus: CardStatus;
  recordDate: string;
  createdAt: string;
}

// 枚举类型
export type CoffeeCategory = 'americano' | 'latte' | 'cappuccino' | 'flat_white' | 'mocha' | 'macchiato' | 'dirty' | 'pour_over' | 'cold_brew' | 'ice_drip' | 'signature' | 'instant' | 'capsule' | 'other';
export type CardSource = 'pre_generated' | 'realtime' | 'fallback';
export type CardStatus = 'pending' | 'matched' | 'generating' | 'generated' | 'failed';
export type RoastLevel = 'light' | 'medium_light' | 'medium' | 'medium_dark' | 'dark';
export type SceneType = 'weekday_morning' | 'weekday_forenoon' | 'weekday_afternoon' | 'weekday_evening' | 'weekday_night' | 'weekend_morning' | 'weekend_forenoon' | 'weekend_afternoon' | 'weekend_evening' | 'weekend_night';

// API 响应格式
export interface ApiResponse<T> {
  code: number;
  msg: string;
  data: T;
}

// 首页 Feed
export interface HomeFeedData {
  greeting: { sceneType: SceneType; hasRecordToday: boolean; text: string };
  todayCards: CoffeeRecord[];
  shopSlot: ShopSlot | null;
  categorySlot: CategorySlot | null;
  surpriseSlot: SurpriseSlot | null;
}
```

**引用方式**：

- NestJS（apps/api）：`import { CoffeeRecord, ApiResponse } from '@coffeenote/shared-types'`
- Next.js（apps/h5）：`import { CoffeeRecord, HomeFeedData } from '@coffeenote/shared-types'`
- Flutter App：手动维护对应的 Dart 数据模型（使用 freezed 或 json_serializable 生成）


