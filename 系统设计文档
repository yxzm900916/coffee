## 五、数据库详细设计

### 5.1 ER 关系图

```
┌──────────┐     1:N     ┌─────────────────┐     N:1     ┌──────────┐
│  users   │────────────>│  coffee_records  │<────────────│  shops   │
└──────────┘             └────────┬────────┘             └──────────┘
                                  │                          
                                  │ N:1 (card_image_url      
                                  │  关联 card_templates)    
                                  ▼                          
                         ┌─────────────────┐                 
                         │ card_templates  │                 
                         └─────────────────┘                 
                                                             
┌──────────┐     1:N     ┌─────────────────┐                 
│  users   │────────────>│ user_shops      │  (用户常用店铺)  
└──────────┘             └─────────────────┘                 
```

核心关系：
- users 1:N coffee_records（一个用户多条记录）
- shops 1:N coffee_records（一个店铺多条记录，shop_id 可为 null）
- card_templates 独立表（通过 brand + coffee_category 关联）
- users 1:N user_shops（用户常用店铺缓存）

### 5.2 完整表结构

#### users（用户表）

```sql
CREATE TABLE users (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    phone           VARCHAR(20) UNIQUE,                   -- 手机号（加密存储）
    openid          VARCHAR(128) UNIQUE,                  -- 微信 openid
    union_id        VARCHAR(128),                         -- 微信 unionid（可选）
    nickname        VARCHAR(50),                          -- 昵称
    avatar_url      VARCHAR(500),                         -- 头像 URL
    default_record_mode VARCHAR(20) DEFAULT 'ask',        -- ask/photo/manual
    notification_enabled BOOLEAN DEFAULT false,           -- 是否开启提醒
    notification_time TIME DEFAULT '15:00:00',            -- 提醒时间
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    last_login_at   TIMESTAMPTZ,
    is_deleted      BOOLEAN NOT NULL DEFAULT false
);

-- 索引
CREATE INDEX idx_users_phone ON users(phone) WHERE NOT is_deleted;
CREATE INDEX idx_users_openid ON users(openid) WHERE NOT is_deleted;
```

#### coffee_records（咖啡记录表）

```sql
CREATE TABLE coffee_records (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id         UUID NOT NULL REFERENCES users(id),
    shop_id         UUID REFERENCES shops(id),            -- 关联店铺（可为 null）
    shop_name       VARCHAR(100),                         -- 店铺名称（冗余，自定义店铺时无 shop_id）
    shop_brand      VARCHAR(50),                          -- 品牌名
    coffee_category VARCHAR(30) NOT NULL,                 -- 品类枚举
    bean_origin     VARCHAR(100),                         -- 豆子产区
    roast_level     VARCHAR(20),                          -- 烘焙度枚举
    process_method  VARCHAR(20),                          -- 处理法枚举
    flavor_tags     TEXT[] DEFAULT '{}',                  -- 风味标签数组
    rating          SMALLINT NOT NULL DEFAULT 3 CHECK (rating BETWEEN 1 AND 5),
    price           DECIMAL(10,2),                        -- 价格（元）
    review          VARCHAR(500),                         -- 文字感受
    photo_urls      TEXT[] DEFAULT '{}',                  -- 原始照片 URL 数组（1-5 张）
    card_image_url  VARCHAR(500),                         -- 卡通形象图 URL
    card_thumbnail_url VARCHAR(500),                      -- 卡通缩略图 URL
    card_source     VARCHAR(20),                          -- pre_generated/realtime/fallback
    card_status     VARCHAR(20) NOT NULL DEFAULT 'pending', -- pending/matched/generating/generated/failed
    record_date     TIMESTAMPTZ NOT NULL,                 -- 喝咖啡时间
    sync_status     VARCHAR(20) DEFAULT 'synced',         -- synced/pending（离线同步用）
    location_point  GEOGRAPHY(POINT, 4326),               -- GPS 坐标（PostGIS）
    location_name   VARCHAR(200),                         -- 地点名称
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    is_deleted      BOOLEAN NOT NULL DEFAULT false
);

-- 核心索引
CREATE INDEX idx_records_user_id ON coffee_records(user_id) WHERE NOT is_deleted;
CREATE INDEX idx_records_user_date ON coffee_records(user_id, record_date DESC) WHERE NOT is_deleted;
CREATE INDEX idx_records_shop_id ON coffee_records(shop_id) WHERE shop_id IS NOT NULL AND NOT is_deleted;
CREATE INDEX idx_records_category ON coffee_records(user_id, coffee_category) WHERE NOT is_deleted;
CREATE INDEX idx_records_brand ON coffee_records(user_id, shop_brand) WHERE shop_brand IS NOT NULL AND NOT is_deleted;
CREATE INDEX idx_records_card_status ON coffee_records(card_status) WHERE card_status IN ('pending', 'generating');
CREATE INDEX idx_records_location ON coffee_records USING GIST(location_point);
CREATE INDEX idx_records_record_date ON coffee_records(user_id, DATE(record_date)) WHERE NOT is_deleted;
```

#### shops（店铺表）

```sql
CREATE TABLE shops (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    brand           VARCHAR(50),                          -- 品牌名（连锁品牌）
    name            VARCHAR(100) NOT NULL,                -- 门店名称
    address         VARCHAR(300),                         -- 地址
    city            VARCHAR(50),                          -- 城市
    location_point  GEOGRAPHY(POINT, 4326),               -- GPS 坐标
    phone           VARCHAR(20),                          -- 电话
    source          VARCHAR(20) NOT NULL DEFAULT 'seed',  -- seed（种子数据）/ user_created（用户创建）
    status          VARCHAR(20) NOT NULL DEFAULT 'active', -- active/pending_review/disabled
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- 索引
CREATE INDEX idx_shops_brand ON shops(brand) WHERE brand IS NOT NULL;
CREATE INDEX idx_shops_location ON shops USING GIST(location_point);
CREATE INDEX idx_shops_city ON shops(city) WHERE city IS NOT NULL;
CREATE INDEX idx_shops_status ON shops(status);
```

#### card_templates（预生成卡片库）

```sql
CREATE TABLE card_templates (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    brand           VARCHAR(50),                          -- 品牌名（null 表示通用）
    coffee_category VARCHAR(30) NOT NULL,                 -- 品类枚举
    image_url       VARCHAR(500) NOT NULL,                -- 卡通形象原图 URL
    thumbnail_url   VARCHAR(500) NOT NULL,                -- 缩略图 URL
    generate_type   VARCHAR(20) NOT NULL DEFAULT 'pre_batch', -- pre_batch（批量预生成）/ realtime（实时生成入库）
    status          VARCHAR(20) NOT NULL DEFAULT 'active', -- active/disabled
    hit_count       INTEGER DEFAULT 0,                    -- 命中次数统计
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- 唯一约束：brand + category 组合唯一
CREATE UNIQUE INDEX idx_card_templates_brand_category 
    ON card_templates(COALESCE(brand, '__generic__'), coffee_category) 
    WHERE status = 'active';

CREATE INDEX idx_card_templates_lookup 
    ON card_templates(brand, coffee_category) WHERE status = 'active';
```

#### user_shops（用户常用店铺）

```sql
CREATE TABLE user_shops (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id         UUID NOT NULL REFERENCES users(id),
    shop_id         UUID NOT NULL REFERENCES shops(id),
    record_count    INTEGER DEFAULT 1,                    -- 在该店铺的记录数
    last_record_at  TIMESTAMPTZ,                          -- 最后一次记录时间
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    
    UNIQUE(user_id, shop_id)
);

CREATE INDEX idx_user_shops_user ON user_shops(user_id, record_count DESC);
```

### 5.3 索引策略说明

| 查询场景 | 使用索引 | 说明 |
|----------|----------|------|
| 首页-今日卡片 | idx_records_user_date | WHERE user_id=? AND DATE(record_date)=today |
| 卡片册-列表视图 | idx_records_user_date | 按时间倒序分页 |
| 卡片册-日历视图 | idx_records_record_date | 按月聚合 |
| 统计-品类排行 | idx_records_category | GROUP BY coffee_category |
| 统计-店铺排行 | idx_records_shop_id | GROUP BY shop_id |
| 统计-品牌排行 | idx_records_brand | GROUP BY shop_brand |
